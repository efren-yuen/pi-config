{
  "mcpServers": {
    "cbm": {
      "command": "/usr/bin/codebase-memory-mcp",
      "description": "代码图索引：符号搜索、调用链追踪、架构概览、变更影响面",
      "timeout": 120,
      "exposure": "codemode",
      "toolExposure": {
        "list_projects": "direct",
        "search_code": "direct",
        "trace_path": "direct",
        "get_architecture": "direct"
      },
      "enabled": false
    },
    "tabularis": {
      "command": "/usr/bin/tabularis",
      "args": [
        "--mcp"
      ],
      "exposure": "codemode",
      "description": "本地数据库客户端（PostgreSQL/MySQL/SQLite）：列出连接与表、读取表结构、执行 SQL"
    }
  }
}
