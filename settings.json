{
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "lastChangelogVersion": "1.4.0",
  "theme": "gruvbox-material",
  "defaultProjectTrust": "ask",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "provider": {
      "maxRetries": 0
    }
  },
  "enableSkillCommands": true,
  "showCacheMissNotices": true,
  "steeringMode": "one-at-a-time",
  "tuiMode": "fullscreen",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "modelThinkingLevels": {
    "opencode-go/qwen3.7-plus": "medium",
    "opencode-go/gpt-5.6-luna": "high",
    "openai-codex/gpt-5.6-terra": "high",
    "opencode-go/deepseek-v4-flash": "high",
    "opencode-go/glm-5.3-flash": "high"
  },
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-slate"
  ],
  "hideThinkingBlock": false,
  "tidy": {
    "enabled": false,
    "icons": false,
    "frameMessages": false,
    "groupTools": false,
    "alwaysShowTools": [
      "edit",
      "write",
      "bash",
      "grep",
      "find"
    ],
    "bashResultLines": 5,
    "diffLines": 40
  }
}